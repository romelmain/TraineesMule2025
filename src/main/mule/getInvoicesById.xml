	<flow name="getInvoicesByIdFlow" doc:id="4972b075-7218-4f5a-9a66-c00427f498f6" >
		<http:listener doc:name="Listener" doc:id="85bf6a90-6b74-4345-800e-cb9f7dbbd8d1" config-ref="HTTP_Listener_config" path="/invoices/{id}"/>
		<logger level="INFO" doc:name="Start getInvoicesByIdFlow" doc:id="08ae6740-8e96-4143-ae73-08861a5e159c" message="Start getInvoicesByIdFlow"/>
		<ee:transform doc:name="Set ID" doc:id="1e960112-f5f5-4a73-8bcb-ab79c50073c8" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="id" ><![CDATA[message.attributes.uriParams."id"]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<db:select doc:name="Select" doc:id="3428e9ac-0125-4c0d-943f-054a0aef1c16" config-ref="Database_Config">
			<db:sql ><![CDATA[select a.id as invoice_id,a.invoice_no,a.date,b.quantity,c.full_name,d.id as product_id, d.description, d.unit_price from invoice a
inner join invoice_detail b on (a.id = b.invoice_id)
inner join customer c on (a.customer_id = c.id)
inner join product d on (b.product_id = d.id)
where a.id = :id
]]></db:sql>
			<db:input-parameters ><![CDATA[#[{"id": vars.id}]]]></db:input-parameters>
		</db:select>
		<ee:transform doc:name="Sin Transformacion" doc:id="397f078f-419f-4894-afbf-55d56a844dad" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload>
			</ee:message>
		</ee:transform>
