http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd">
	<flow name="getCustomerByIdFlow" doc:id="405dd8f2-bfc1-4665-8c68-2995b41b265a" >
		<http:listener doc:name="Listener" doc:id="74049642-a3a6-4977-b54a-4178d4e62430" config-ref="HTTP_Listener_config" path="/customers/{id}"/>
		<logger level="INFO" doc:name="Start getCustomerByIdFlow" doc:id="86b00bca-1e0f-4aec-9ec6-dae8cff4fe20" message="Start getCustomerByIdFlow" />
		<ee:transform doc:name="Set ID" doc:id="fc0f7dec-22b5-4644-8ff3-94fa3484c78d" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="id" ><![CDATA[message.attributes.uriParams."id"]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<db:select doc:name="Select" doc:id="f26d3af9-e8ce-47ac-bea6-fef7329a1675" config-ref="Database_Config">
			<db:sql ><![CDATA[select * from customer where id = :id]]></db:sql>
			<db:input-parameters ><![CDATA[#[{"id": vars.id}]]]></db:input-parameters>
		</db:select>
		<ee:transform doc:name="Transform Message" doc:id="695210b2-60d1-40a7-bc51-b398c7567e4e" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="End getCustomerByIdFlow" doc:id="b3623c5f-9209-4ffd-b60e-d2c01a322c0c" message="End getCustomerByIdFlow" />
	</flow>
</mule>
